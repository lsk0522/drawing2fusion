# Copy to .env (read automatically by `python -m d2f ...` from the current folder)

# Bridge (must match the add-in; the add-in reads the same env vars when Fusion starts)
D2F_BRIDGE_HOST=127.0.0.1
D2F_BRIDGE_PORT=8765
# D2F_BRIDGE_TOKEN=        # default: read from %USERPROFILE%\.d2f\token written by the add-in

# Alerts: console, fusion, discord, telegram
D2F_NOTIFY_CHANNELS=console,fusion
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Verification
D2F_DEFAULT_TOL_MM=0.05

# Drawing reading (Phase 4)
ANTHROPIC_API_KEY=
